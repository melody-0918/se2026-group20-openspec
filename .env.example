# 僅供參考；請在目前終端機設定環境變數，勿複製實際機敏值到 repo。
GUIDED_NOTES_SECRET_KEY=replace-with-a-random-local-secret
GUIDED_NOTES_DATABASE=instance/guided_notes.sqlite3
GUIDED_NOTES_DEMO_CATALOG=0

# notes 真正使用 Google Sheets 功能時，設為 repo 外的檔案路徑。
NOTES_GOOGLE_CLIENT_SECRETS=C:\private\google-client.json
NOTES_GOOGLE_TOKEN=C:\private\google-token.json
